# Vite Environment Variables (Frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# WhatsApp Default Number
VITE_WHATSAPP_NUMBER=919876543210

# Supabase Project Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Resend / Custom SMTP Settings for Supabase Auth
# Option A: Resend (Recommended - 3,000 emails/month free)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_SENDER_EMAIL=onboarding@resend.dev

# Option B: Gmail SMTP
SMTP_ADMIN_EMAIL=your_email@gmail.com
SMTP_SENDER_NAME=NICE LOOKING Portal
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key_here